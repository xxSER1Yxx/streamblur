{
  "manifest_version": 3,
  "name": "StreamBlur Time Bridge",
  "version": "0.1.0",
  "description": "Отдаёт точное время активного <video> в StreamBlur для автоблюра в OBS.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_title": "StreamBlur Time Bridge" },
  "icons": {}
}
